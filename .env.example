# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# NOTE: there is no TENANT_ID and there never will be. tenant_id is derived
# from the authenticated session, never configured and never passed in as an
# argument (AGENTS.md rule 7).

# Owner/admin connection. Runs migrations and provisions test databases.
# Must NOT serve requests. Create it once, connected as a superuser
# (see README "Setup") — createrole is required, migration 0000
# provisions the app role AS this owner:
#   create role parentline_owner login createdb createrole;
DATABASE_URL=postgres://parentline_owner@localhost:5432/parentline

# Application connection — a NON-owner, NON-superuser role. Table owners and
# superusers bypass RLS silently, so if this is the same role as DATABASE_URL
# the isolation gate is vacuous. Required in production.
APP_DATABASE_URL=postgres://parentline_app@localhost:5432/parentline

# Minutes before a roster is stale and reads refuse rather than answer.
ROSTER_FRESHNESS_MINUTES=45

LOG_LEVEL=info

# Google Sheets connector (PL-005). Read-only service account access.
# Path to the key file downloaded from Google Cloud Console (service
# account → Keys). The KEY ITSELF never goes in an environment variable —
# secrets live in files under ./secrets/ (gitignored) referenced by path.
# Optional — connector is dormant until provided.
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/sa.json

# Default roster sheet ID for scheduled sync (PL-007). Optional.
# ROSTER_SHEET_ID=

# ── MCP server (Sprint 2) ──────────────────────────────────────────────
# Bind host/port for the Streamable HTTP MCP server.
MCP_HOST=127.0.0.1
MCP_PORT=8420

# Canonical external URL of this server (RFC 8707 resource identifier).
# Used verbatim in the protected-resource metadata; never derived from
# request headers. Required in production.
RESOURCE_URL=http://127.0.0.1:8420

# Authorization server. AS-agnostic (PL-101): issuer, JWKS URL, audience,
# and claim names are config-driven. Required in production.
AS_ISSUER=https://your-auth-server.example.org
AS_JWKS_URL=https://your-auth-server.example.org/.well-known/jwks.json
EXPECTED_AUDIENCE=http://127.0.0.1:8420

# Token claims carrying the caller's tenant and role. Defaults shown.
# TENANT_CLAIM=tenant_id
# ROLE_CLAIM=role

# Explicit, small clock-skew tolerance for token expiry (seconds).
# CLOCK_SKEW_SECONDS=30

# Allowed Origin values for DNS-rebinding protection (comma-separated).
# Requests carrying an Origin not in this list are rejected.
ALLOWED_ORIGINS=https://claude.ai

# Idle-session TTL for Mcp-Session-Id (minutes).
SESSION_TTL_MINUTES=60

# Proactive JWKS refresh interval (minutes). The server refetches keys
# off the request path so a request never pays the cold fetch after
# deploy or AS key rotation.
JWKS_REFRESH_MINUTES=10

# Optional. Enables semantic checks in .windsurf/hooks (failure-check, spike-gate).
# Unset = hooks fall back to deterministic behaviour. Never required to build.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT=4.0

# Slack request-signing secret (PL-207) — shared with Slack, verifies inbound
# interaction payloads. Synthetic in development; empty = the endpoint fails
# closed and accepts nothing until a real secret is configured.
SLACK_SIGNING_SECRET=

# Escalation worker (PL-204/254): directory of per-tenant written ladders —
# <dir>/<tenant_id>.json for every WORKER_TENANTS entry. REQUIRED — the worker
# refuses to start without it, naming the tenant and the missing path. The
# ladder is a P2 decision; fixture ladders live in src/fixtures/escalation/.
ESCALATION_LADDER_DIR=
# Comma-separated tenant ids the worker processes.
WORKER_TENANTS=
# Skip/failure ceiling before a row stalls to a human handoff (default 20).
ESCALATION_MAX_ATTEMPTS=

# Slack interaction endpoint (PL-257): comma-separated tenant ids probed for
# every inbound action — the probe count is constant whether the id resolves
# or not, which is what makes cross-tenant and nonexistent indistinguishable.
SLACK_TENANT_IDS=
