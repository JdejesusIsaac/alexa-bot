# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# NOTE: there is no TENANT_ID and there never will be. tenant_id is derived
# from the authenticated session, never configured and never passed as an
# argument (AGENTS.md rule 7).

# Owner/admin connection. Runs migrations. Must NOT serve requests.
DATABASE_URL=postgres://juanisaac@localhost:5432/parentline_dev

# Application connection — a NON-owner, NON-superuser role.
# Table owners and superusers bypass RLS silently, so if this is the same
# role as DATABASE_URL the isolation gate is vacuous. Required in production.
APP_DATABASE_URL=postgres://parentline_app:CHANGE_ME@localhost:5432/parentline_dev

# Minutes before a roster is stale and reads refuse rather than answer.
ROSTER_FRESHNESS_MINUTES=45

LOG_LEVEL=info

# Google Sheets connector (PL-005). Read-only service account access.
# Paste the full JSON key from Google Cloud Console (service account → Keys).
# Optional — connector is dormant until provided.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...",...}

# Default roster sheet ID for scheduled sync (PL-007).
# ROSTER_SHEET_ID=your-sheet-id-from-google-sheets-url
